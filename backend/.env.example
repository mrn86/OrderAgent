APP_NAME=order-agent
APP_ENV=dev
API_PREFIX=/v1
ACCESS_TOKEN=test-token

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LiteLLM Router
LITELLM_PRIMARY_MODEL=deepseek/deepseek-chat
LITELLM_FALLBACK_MODEL=deepseek/deepseek-chat
LITELLM_RPM=60
LITELLM_TPM=100000
LITELLM_NUM_RETRIES=2
LITELLM_TIMEOUT=60

# 可选：OpenAI 作为额外 fallback（配置 OPENAI_API_KEY 后生效）
# OPENAI_API_KEY=
# LITELLM_OPENAI_FALLBACK_MODEL=openai/gpt-4o-mini

# 网关 HTTP 限流：每 token 每分钟请求数
GATEWAY_RATE_LIMIT_PER_MINUTE=30

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/order_agent
# SSE 流式会话依赖 Redis Stream，需 Redis 5.0+
REDIS_URL=redis://localhost:6379/0
USE_FAKE_DATA=true
HUMAN_CS_URL=http://www.baidu.com

# 路由 → 专家 A2A（完全替换 Redis dispatch/events/control）
ORDER_EXPERT_A2A_URL=http://127.0.0.1:8001
LOGISTICS_EXPERT_A2A_URL=http://127.0.0.1:8003
INVOICE_EXPERT_A2A_URL=http://127.0.0.1:8002
# 专家进程 AgentCard 对外 URL；留空则按角色使用上方对应地址
# EXPERT_A2A_PUBLIC_URL=http://127.0.0.1:8001

# 上下文压缩（发给模型的视图；checkpoint 仍全量）
CONTEXT_COMPRESS_MAX_MESSAGES=40
CONTEXT_COMPRESS_MAX_TOKENS=8000
CONTEXT_KEEP_RECENT_TURNS=3
CONTEXT_TOOL_RESULT_MAX_CHARS=4000
